# Application
APP_ENV=development
APP_BASE_URL=http://localhost:8000

# Required for protected API endpoints
EC_PULSE_API_KEY=

# PostgreSQL connection string for monitor persistence
DATABASE_URL=

# Secret used by the scheduled monitor checker
CRON_SECRET=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Optional monthly credit quotas for usage alerts (leave blank if credits are not monthly)
EC_PULSE_FREE_MONTHLY_CREDITS=100
EC_PULSE_PRO_MONTHLY_CREDITS=
EC_PULSE_BUSINESS_MONTHLY_CREDITS=

# Official marketplace search APIs (optional; HTML fallback when unset)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_CREDENTIAL_VERSION=3.3
YAHOO_SHOPPING_APP_ID=
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# Supabase Auth / Google Login
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
