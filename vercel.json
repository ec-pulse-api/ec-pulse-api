{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/patrol",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/check-monitors",
      "schedule": "*/5 * * * *"
    }
  ]
}
